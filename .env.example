# python3 scripts/configure.py creates .env with independent random credentials.
SYNC_USER=reader
SYNC_PASSWORD=
SYNC_API_KEY=

# Local access by default. For readers on your trusted LAN, set the server's LAN IP
# or 0.0.0.0. The shelf on WEB_PORT has NO LOGIN; do not expose it to the internet.
BOOKHUB_BIND=127.0.0.1
WEB_PORT=8088
SYNC_PORT=8089
# Optional allowed shelf hostnames, including ports: 192.168.1.10:8088
SHELF_HOSTS=
CORS_ORIGINS=

# Optional AI endpoint base URL (the app appends /v1/chat/completions).
# Empty URL/model disables AI. Every generation requires an explicit request.
AI_URL=
AI_MODEL=
AI_API_KEY=
AI_SUMMARY_MODEL=
AI_HINT_MODEL=
AI_TIMEOUT_SEC=300

# Optional CrossPoint X3 Wi-Fi file-transfer address, e.g. http://192.168.1.20
X3_URL=
X3_BOOKS_DIR=/
X3_SYNC_DEVICE=

PREFER_LANG=ru
TRANSLATE_TITLES=1
CONTACT_EMAIL=
LOG_LEVEL=INFO
